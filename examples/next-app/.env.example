# Copy to .env.local and fill in what you use.

DATABASE_URL=postgres://localhost/nextbase_example

# The URL you open the app at. OAuth2 redirects are built from it.
APP_URL=http://localhost:3000

# OAuth2 providers: each one shows up on /sign-in once its values are set.
# At each provider, register its redirect URI:
#   http://localhost:3000/api/nextbase/callback/github
#   http://localhost:3000/api/nextbase/callback/google
#   http://localhost:3000/api/nextbase/callback/oidc

# https://github.com/settings/developers -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where uploaded files are kept. Defaults to .nextbase/storage.
STORAGE_DIR=

# Phone sign-in, for auth collections with phoneAuth on. Your SMS gateway
# receives a POST of { "to": "+255712345678", "text": "..." } and sends it on
# with Twilio, Africa's Talking or another provider. Without it, codes are
# logged in development.
SMS_WEBHOOK_URL=
# The countries texts may go to, such as TZ,KE.
SMS_COUNTRIES=

# Any OpenID Connect provider, such as Microsoft, Auth0, Okta or Keycloak.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=
