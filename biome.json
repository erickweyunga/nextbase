{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/next-env.d.ts"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error",
        "noNamespace": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        },
        "useConst": "error",
        "useDefaultSwitchClause": "error",
        "useArrayLiterals": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error"
      },
      "suspicious": {
        "noDoubleEquals": "error",
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noVar": "error"
      },
      "complexity": {
        "noStaticOnlyClass": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.config.ts",
        "**/*.d.ts",
        "apps/docs/sidebars.ts",
        "apps/docs/src/pages/**",
        "examples/*/app/**/page.tsx",
        "examples/*/app/**/layout.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/nextbase-admin/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["baseui/icon/*"],
                    "message": "Import Base Web's icons by name from 'baseui/icon': these per-icon files are CommonJS defaults, which Vite does not unwrap, so React gets an object and crashes."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
