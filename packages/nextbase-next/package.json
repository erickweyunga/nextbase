{
  "name": "@nextbasejs/next",
  "version": "0.1.10",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "description": "NextBase for Next.js: route handlers and a server client that reads the session cookie.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erickweyunga/nextbase.git",
    "directory": "packages/nextbase-next"
  },
  "keywords": [
    "nextjs",
    "backend",
    "auth"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "check:package": "publint --strict && attw --pack --profile esm-only",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nextbasejs/client": "workspace:^",
    "@nextbasejs/core": "workspace:^",
    "next": ">=16"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@nextbasejs/client": "workspace:*",
    "@nextbasejs/core": "workspace:*",
    "@types/node": "catalog:",
    "next": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
