{
  "name": "@nextbase/nextbase",
  "version": "0.0.0",
  "description": "Your backend, built into Next.js: database, auth, file storage and auto-generated APIs.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maverickweyunga/nextbase.git",
    "directory": "packages/nextbase"
  },
  "keywords": [
    "nextjs",
    "backend",
    "baas",
    "postgres",
    "auth"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "test": "vitest run",
    "check:package": "publint --strict && attw --pack --profile esm-only"
  },
  "dependencies": {
    "jose": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@nextbase/admin": "workspace:*",
    "@nextbase/dbx": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
