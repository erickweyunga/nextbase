{
  "name": "@nextbasejs/core",
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "description": "Your backend, built into your app: database, auth and auto-generated APIs on Postgres, served from any framework that speaks web-standard Request and Response.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erickweyunga/nextbase.git",
    "directory": "packages/nextbase-core"
  },
  "keywords": [
    "backend",
    "baas",
    "postgres",
    "auth",
    "nextjs"
  ],
  "bin": {
    "nextbase": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "check:package": "publint --strict && attw --pack --profile esm-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@nextbasejs/client": "workspace:*",
    "@vercel/functions": "catalog:",
    "file-type": "catalog:",
    "jose": "catalog:",
    "libphonenumber-js": "catalog:",
    "oauth4webapi": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@nextbasejs/admin": "workspace:*",
    "@nextbasejs/dbx": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
