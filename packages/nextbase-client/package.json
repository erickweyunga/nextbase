{
  "name": "@nextbasejs/client",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "description": "The NextBase SDK: records, auth and sessions, for browsers and any JavaScript runtime.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erickweyunga/nextbase.git",
    "directory": "packages/nextbase-client"
  },
  "keywords": [
    "backend",
    "sdk",
    "auth",
    "postgres"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "check:package": "publint --strict && attw --pack --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
