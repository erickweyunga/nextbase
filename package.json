{
  "name": "nextbase-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "knip": "knip",
    "check": "biome check . && turbo run typecheck test build check:package && knip",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='./packages/*' && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "knip": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "examples/*"
    ],
    "catalog": {
      "@arethetypeswrong/cli": "^0.18.5",
      "@biomejs/biome": "^2.5.15",
      "@changesets/cli": "^3.0.3",
      "@docusaurus/core": "3.10.2",
      "@docusaurus/faster": "3.10.2",
      "@docusaurus/module-type-aliases": "3.10.2",
      "@docusaurus/plugin-content-docs": "3.10.2",
      "@docusaurus/preset-classic": "3.10.2",
      "@docusaurus/theme-classic": "3.10.2",
      "@docusaurus/types": "3.10.2",
      "@easyops-cn/docusaurus-search-local": "^0.55.3",
      "@fontsource-variable/google-sans": "^5.3.2",
      "@fontsource-variable/google-sans-code": "^5.3.2",
      "@mdx-js/react": "^3.1.1",
      "@types/node": "^24.13.4",
      "@types/pg": "^8.23.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vercel/functions": "^3.9.11",
      "jose": "^6.2.11",
      "knip": "^6.41.0",
      "next": "^16.4.2",
      "pg": "^8.23.1",
      "prism-react-renderer": "^2.4.1",
      "publint": "^0.3.25",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "server-only": "^0.0.1",
      "tsdown": "^0.23.1",
      "turbo": "^2.11.9",
      "typescript": "^7.0.2",
      "vite": "^8.3.4",
      "vite-plugin-singlefile": "2.3.3",
      "vitest": "^5.0.5"
    }
  }
}
